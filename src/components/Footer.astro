---
import Button from "./Button";

import logoIcon from "../assets/logo-o.svg?raw"
import logoRyoma from "../assets/logotipo-ryoma.svg?raw"

import linkedinLogo from "../assets/socials/linkedin.svg?raw"
import githubLogo from "../assets/socials/github.svg?raw"

const currentYear = new Date().getFullYear()
---

<footer class="site-footer" role="contentinfo">
    <div class="footer-inner">
        
        <!-- zona superior -->
         <div class="footer-top">
        
            <!-- columna 1 -->
             <div class="footer-brand">
                <a href="/" aria-label="Ir al inicio" class="flex items-center gap-3">
                    <span class="footer-logo-icon" set:html={logoIcon} />
                    <span class="footer-logo-text" set:html={logoRyoma} />
                </a>
                <p class="footer-tagline">Soluciones digitales con precisión metódica.</p>
                <p class="footer-subtagline">Trabajo remoto · Proyectos a medida</p>
             </div>

             <!-- columna 2 -->
              <nav class="footer-nav" aria-label="Navegación del footer">
                <p class="footer-nav-label">Navegación</p>
                <a href="#" class="footer-nav-link">Inicio</a>
                <a href="#about" class="footer-nav-link">Sobre mí</a>
                <a href="#services" class="footer-nav-link">Servicios</a>
                <a href="#projects" class="footer-nav-link">Proyectos</a>
                <a href="#process" class="footer-nav-link">Proceso</a>
                <a href="#contact" class="footer-nav-link">Contacto</a>
              </nav>

              <!-- columna 3 -->
               <div class="footer-contact">
                <p class="footer-contact-label">Contacto</p>
                <a href="mailto:hola@ryoma.com" class="footer-contact-item">
                    hola@ryoma.com
                </a>
                <span class="footer-contact-item">+54 9 221 6069 6954</span>

                <div class="footer-socials">
                    <a href="https://linkedin.com/in/dcastroandrich" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <span set:html={linkedinLogo} aria-hidden="true" />
                    </a>

                    <a href="https://github.com/DCastroAndrich" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="GitHub" >
                        <span set:html={githubLogo} aria-hidden="true" />
                    </a>
                </div>
                <div class="footer-cta">
                    <Button href="#contact" variant="outline" size="sm" client:load>
                        Enviar mensaje
                    </Button>
                </div>
               </div>

         </div>
         <!-- separador -->
          <div class="footer-divider" aria-hidden="true"/>

          <!-- zona inferior -->
           <div class="footer-bottom">
            <p class="footer-copyright">
                © {currentYear} Ryōma Development. Todos los derechos reservados.
            </p>
            <div class="footer-legal-links">
                <span class="footer-legal-dot">·</span>
                <a href="/privacidad" class="footer-legal-link">Política de privacidad</a>
                <span class="footer-legal-dot">·</span>
                <a href="/terminos" class="footer-legal-link">Términos</a>
                <span class="footer-legal-dot">·</span>
            </div>
           </div>
    </div>
</footer>