---
interface Props{
    variant?: "solid" | "outline" | "ghost" | "link";
    href?: string;
    ariaLabel?: string;
    type?: "button"|"submit"| "reset";
    disabled?: boolean;
    loading?: boolean;
    iconRightHtml?: string | null;
    uppercase?: boolean;
    gradient?: string;
    gradientInv?: string;
}

const {
    variant = "solid",
    href,
    ariaLabel = "",
    type = "button",
    disabled = false,
    loading = false,
    iconRightHtml = null,
    uppercase = true,
    gradient,
    gradientInv
} = Astro.props as Props;

// Gradientes por defecto
const grad = gradient ?? "linear-gradient(120deg, var(--gradient-start) 9%, var(--gradient-end) 81%)";
const gradInv = gradientInv ?? "linear-gradient(120deg, var(--gradient-end) 9%, var(--gradient-start) 81%)"

// Estilo inline con variable para cambiar en :hover
const wrapperStyle = `--grad: ${grad}; --grad-inv: ${gradInv}; background-image: var(--grad); border-radius: 16px; padding: 2px`;

const isLink = typeof href === "string" && href.length > 0;
const innerRadius = 14

---
<html:fragment>
    {isLink? (
        <a 
            href={href}
            class="neon-wrap"
            role="link"
            style={wrapperStyle}
            data-variant={variant}
            aria-label={ariaLabel}
            aria-disabled={disabled ? 'true' : 'false'}
            data-loading={loading ? 'true' : 'false'}
        >
            <span class="neon-inner" style={`border-radius: ${innerRadius}px`}>
                <span class={`neon-content ${uppercase ? 'uppercase' : ''} `} style="font-family: var(--font-heading); font-weight: 600; font-size: 16px; letter-spacing: 0.06em; color: var(--text-text-primary); line-height: normal;" >
                    <slot/>
                    {iconRightHtml ? <span class="ml-2" innerHtml={iconRightHtml} /> : null }
                    <slot name="iconRight" />
                </span>
            </span>
        </a>
    ): (
        <button
        type={type}
        class="neon-wrap"
        disabled={disabled || loading}
        aria-label={ariaLabel}
        aria-busy={loading ? 'true' : 'false'}
        aria-disabled={disabled ? 'true' : 'false'}
        style={wrapperStyle}
        data-variant={variant}
        data-loading={loading ? 'true' : 'false'}
        >
            <span class="neon-inner" style={`border-radius: ${innerRadius}px;`} >
                <span
                class={`neon-content ${uppercase ? 'uppercase' : ''}`}
                style="font-family: var(--font-heading); font-weight: 600; font-size: 16px; letter-spacing: 0.06em; color: var(--text-text-primary); line-height: normal;"
                >
                    <slot/>
                    {iconRightHtml ? <span class="ml-2" innerHtml={iconRightHtml} /> : null}
                    <slot name="iconRight" />
                    {loading ? (
            <svg class="neon-spinner ml-2" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="rgba(255,255,255,0.15)" stroke-width="4" fill="none"></circle>
              <path d="M22 12a10 10 0 00-10-10" stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none"></path>
            </svg>
          ) : null}
                </span>
            </span>
        </button>
    )}
</html:fragment>

<style>
    /* Wrapper: gradiente border + glow */
    .neon-wrap {
        display: inline-block;
        background-size: ;
    }

</style>
