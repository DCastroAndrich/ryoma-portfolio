---
interface Props {
  id: string;
  variant?: "case-study" | "document" | "card" | "lightbox";
  ariaLabel?: string;
}

const { id, variant = "case-study", ariaLabel = "Modal de contenido" } = Astro.props;

const isLightbox = variant === "lightbox";

const containerClass = ["modal-container", `modal-${variant}`].join(" ");
---

<div
  id={id}
  class={`modal-overlay ${isLightbox ? "modal-lightbox" : ""}`}
  role="dialog"
  aria-modal="true"
  aria-label={ariaLabel}
  data-modal
>
  <div class={containerClass}>
    {
      isLightbox ? (
        <slot />
      ) : (
        <>
          <button type="button" class="modal-close" aria-label="Cerrar modal" data-modal-close>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6L6 18" />
              <path d="M6 6L18 18" />
            </svg>
          </button>

          <slot />
        </>
      )
    }
  </div>
</div>
