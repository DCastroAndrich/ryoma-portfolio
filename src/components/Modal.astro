---
interface Props{
    id: string;
    variant?: "case-study" | "document" | "card" | "lightbox";
    ariaLabel?: string
}

const {id, variant = "case-study", ariaLabel ="Modal de contenido"} = Astro.props

const containerClass = [
    "modal-container", variant && `modal-${variant}`].filter(Boolean).join(" ")
---
<div id={id} class={`modal-overlay ${variant === "lightbox" ? "modal-lightbox" : ""}`} role="dialog" aria-modal="true" aria-label={ariaLabel} data-modal >
    <div class={containerClass}>
        <!-- boton de cierre -->
         <button class="modal-close" aria-label="Cerrar modal" data-modal-close type="button">
                <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M18 6 6 18M6 6l12 12" />
        </svg>
         </button>
         <slot/>
    </div>
</div>
