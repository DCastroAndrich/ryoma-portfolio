---
import ThemeToggle from "./ThemeToggle.tsx";
import Button from "./Button";

import logoIcon from "../assets/logo-o.svg?raw";
---

<nav
  id="site-navbar"
  class="fixed inset-x-0 top-0 z-50"
  role="navigation"
  aria-label="Barra de navegación"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between md:h-20">
      <a href="/" class="z-30 flex items-center gap-3" aria-label="Ir al inicio">
        <span
          class="block h-6 w-auto"
          style="aspect-ratio: 278 / 200;"
          set:html={logoIcon}
          aria-hidden="true"
        />
      </a>

      <div class="hidden items-center gap-8 md:flex">
        <ul class="font-heading relative flex items-center gap-8 text-sm" id="nav-container">
          <li id="nav-pill" aria-hidden="true" role="presentation"></li>
          <li><a href="#about" class="nav-link group relative px-1 py-2">Acerca de mí</a></li>
          <li><a href="#services" class="nav-link group relative px-1 py-2">Servicios</a></li>
          <li><a href="#projects" class="nav-link group relative px-1 py-2">Proyectos</a></li>
          <li><a href="#process" class="nav-link group relative px-1 py-2">Proceso</a></li>
          <li><a href="#contact" class="nav-link group relative px-1 py-2">Contacto</a></li>
        </ul>

        <div class="flex items-center gap-4">
          <ThemeToggle client:load className="theme-toggle" />
          <Button href="#contact" variant="outline" size="sm">Hablemos</Button>
        </div>
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle client:load className="theme-toggle" />

        <button
          id="nav-toggle"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
          type="button"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="mobile-menu pointer-events-none fixed inset-0 z-60 opacity-0 transition-all duration-300 md:hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nav-toggle"
    aria-hidden="true"
    hidden
    inert
  >
    <div id="mobile-backdrop" class="mobile-backdrop bg-bg backdrop-blur-sm" aria-hidden="true">
    </div>

    <div class="relative z-10 h-full w-full pt-16 backdrop-blur-2xl">
      <div
        class="bg-bg mx-auto flex max-h-[calc(100dvh-64px)] w-full flex-col gap-4 overflow-y-auto px-4 py-6 sm:px-6"
      >
        <div class="flex items-center justify-between">
          <a href="/" aria-label="Ir al inicio">
            <span
              class="block h-6 w-auto"
              style="aspect-ratio: 278 / 200;"
              set:html={logoIcon}
              aria-hidden="true"
            />
          </a>

          <button
            id="nav-close"
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg focus:outline-none"
            aria-label="Cerrar menú"
            type="button"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M6 6l12 12M6 18L18 6"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>

        <nav class="font-body flex flex-col gap-2" aria-label="Menú móvil">
          <a
            href="#about"
            class="nav-link flex min-h-12 w-full items-center rounded-md px-5 py-4 text-left"
          >
            Acerca de mí
          </a>
          <a
            href="#services"
            class="nav-link flex min-h-12 w-full items-center rounded-md px-5 py-4 text-left"
          >
            Servicios
          </a>
          <a
            href="#projects"
            class="nav-link flex min-h-12 w-full items-center rounded-md px-5 py-4 text-left"
          >
            Proyectos
          </a>
          <a
            href="#process"
            class="nav-link flex min-h-12 w-full items-center rounded-md px-5 py-4 text-left"
          >
            Proceso
          </a>
          <a
            href="#contact"
            class="nav-link flex min-h-12 w-full items-center rounded-md px-5 py-4 text-left"
          >
            Contacto
          </a>
        </nav>

        <div class="mt-2 flex flex-col gap-3 border-t border-[rgba(255,255,255,0.08)] pt-2">
          <Button href="#contact" variant="outline" size="sm">Hablemos</Button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const nav = document.getElementById("site-navbar");
      if (!nav) return;

      const toggleBtn = document.getElementById("nav-toggle");
      const closeBtn = document.getElementById("nav-close");
      const mobileMenu = document.getElementById("mobile-menu");
      const mobileBackdrop = document.getElementById("mobile-backdrop");
      const threshold = 16;

      const navContainer = document.getElementById("nav-container");
      const pill = document.getElementById("nav-pill");
      const navLinks = navContainer?.querySelectorAll<HTMLElement>(".nav-link") ?? [];
      const sections = document.querySelectorAll<HTMLElement>("section[id]");

      let activeLink: HTMLElement | null = null;
      let hoverTimeout: ReturnType<typeof setTimeout> | null = null;
      let pillX = 0;

      const clearHoverTimeout = (): void => {
        if (hoverTimeout !== null) {
          clearTimeout(hoverTimeout);
          hoverTimeout = null;
        }
      };

      const movePill = (element: HTMLElement): void => {
        if (!pill || !navContainer) return;

        const containerRect = navContainer.getBoundingClientRect();
        const rect = element.getBoundingClientRect();
        const x = rect.left - containerRect.left;

        const distance = Math.abs(x - pillX);
        const duration = Math.min(Math.max(distance * 0.4, 220), 420);

        pill.style.transitionDuration = `${duration}ms`;
        pill.style.width = `${rect.width}px`;
        pill.style.transform = `translateX(${x}px)`;
        pill.style.opacity = "1";

        pillX = x;
      };

      const hidePill = (): void => {
        if (!pill) return;

        pill.style.opacity = "0";
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const id = entry.target.getAttribute("id");

            const link = [...navLinks].find((navLink) => navLink.getAttribute("href") === `#${id}`);

            if (!link) return;

            activeLink = link;
            movePill(link);

            navLinks.forEach((navLink) => {
              navLink.classList.remove("active");
            });

            link.classList.add("active");

            document.querySelectorAll<HTMLElement>(".mobile-menu .nav-link").forEach((navLink) => {
              navLink.classList.toggle("active", navLink.getAttribute("href") === `#${id}`);
            });
          });
        },
        {
          rootMargin: "-45% 0px -50% 0px",
          threshold: 0,
        },
      );

      sections.forEach((section) => {
        observer.observe(section);
      });

      const handleScroll = (): void => {
        const y = window.scrollY || window.pageYOffset;

        if (y > threshold) {
          nav.classList.add("scrolled");
        } else {
          nav.classList.remove("scrolled");
        }

        if (y < 80) {
          activeLink = null;
          hidePill();
        } else if (activeLink) {
          movePill(activeLink);
        }
      };

      navLinks.forEach((link) => {
        link.addEventListener("mouseenter", () => {
          clearHoverTimeout();

          hoverTimeout = setTimeout(() => {
            movePill(link);
          }, 90);
        });

        link.addEventListener("mouseleave", () => {
          clearHoverTimeout();

          hoverTimeout = setTimeout(() => {
            if (activeLink) {
              movePill(activeLink);
            } else {
              hidePill();
            }
          }, 100);
        });
      });

      const openMenu = (): void => {
        nav.classList.add("menu-open");
        toggleBtn?.setAttribute("aria-expanded", "true");

        if (mobileMenu) {
          mobileMenu.hidden = false;
          mobileMenu.style.pointerEvents = "auto";

          requestAnimationFrame(() => {
            mobileMenu.inert = false;
            mobileMenu.setAttribute("aria-hidden", "false");
          });
        }

        document.documentElement.style.overflow = "hidden";
      };

      const closeMenu = (): void => {
        nav.classList.remove("menu-open");
        toggleBtn?.setAttribute("aria-expanded", "false");

        if (mobileMenu) {
          mobileMenu.setAttribute("aria-hidden", "true");
          mobileMenu.inert = true;
          mobileMenu.style.pointerEvents = "none";

          setTimeout(() => {
            mobileMenu.hidden = true;
          }, 300);
        }

        document.documentElement.style.overflow = "";
      };

      const toggleMenu = (): void => {
        if (nav.classList.contains("menu-open")) {
          closeMenu();
        } else {
          openMenu();
        }
      };

      handleScroll();

      window.addEventListener("scroll", handleScroll, {
        passive: true,
      });

      mobileBackdrop?.addEventListener("click", closeMenu);
      closeBtn?.addEventListener("click", closeMenu);
      toggleBtn?.addEventListener("click", toggleMenu);

      mobileMenu?.querySelectorAll<HTMLElement>("a[href^='#']").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
        }
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) {
          closeMenu();
        }
      });
    })();
  </script>
</nav>
