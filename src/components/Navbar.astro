---
import ThemeToggle from "./ThemeToggle"
import Button from "./Button"
---
<nav id="site-navbar" class="fixed top-0 left-0 w-full z-50" role="navigation" aria-label="Barra de navegación">
    <div class="max-w-300 mx-auto px-6 sm:px-8 ">
        <div class="flex items-center justify-between h-20">
            <!-- logos -->
             <a href="/" class="flex items-center gap-3 z-30">
                <span class="relative inline-block h-8 w-auto">
                    <!-- logo modo claro -->
                    <img src="/src/assets/logo-dark.svg" alt="Ryōma" class="h-8 w-auto logo-light" />
                    <!-- logo modo oscuro -->
                    <img src="/src/assets/logo-light.svg" alt="Ryōma" class="h-8 w-auto logo-dark" />

                </span>
             </a>

             <!-- Desktop links -->
              <ul class="hidden md:flex items-center gap-8 text-sm font-heading">
                <li><a href="#about" class="nav-link group relative px-1 py-2">Acerca de mí</a></li>
                <li><a href="#services" class="nav-link group relative px-1 py-2">Servicios</a></li>
                <li><a href="#projects" class="nav-link group relative px-1 py-2">Proyectos</a></li>
                <li><a href="#results" class="nav-link group relative px-1 py-2">Resultados</a></li>
                <li><a href="#process" class="nav-link group relative px-1 py-2">Proceso</a></li>
                <li><a href="#contact" class="nav-link group relative px-1 py-2">Contacto</a></li>
              </ul>

              <!-- Toogle y CTA -->
               <div class="flex items-center gap-4">
                <!-- toogle -->
                <ThemeToggle client:load className="theme-toogle" />
                
                <!-- CTA -->
                 <Button client:load href="#contact" className="hidden md:inline-flex md:text-xs md:bg-transparent" variant="outline" >
                    Hablemos
                 </Button>

                 <!-- Menu hamburguesa -->
                  <button id="nav-toggle" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2" type="button">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" aria-hidden>
                        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
               </div>
        </div>
    </div>

    <div id="mobile-menu" class="mobile-menu md:hidden" role="menu" aria-labelledby="nav-toggle" aria-hidden="true" >
        <div class="max-w-300 mx-auto px-6 sm:px-8 py-6 flex flex-col gap-4">
            <div class="flex items-center justify-between">
                <a href="/" class="flex items-center gap-3">
                    <span class="relative inline-block h-8 w-auto">
                       <!-- logo modo claro -->
                    <img src="/src/assets/logo-dark.svg" alt="Ryōma" class="h-8 w-auto logo-light" />
                    <!-- logo modo oscuro -->
                    <img src="/src/assets/logo-light.svg" alt="Ryōma" class="h-8 w-auto logo-dark" />

                    </span>
                 </a>
                 <button id="nav-close" class="inline-flex items-center justify-center w-10 h-10 rounded-lg focus:outline-none" aria-label="Cerrar menú">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden>
                        <path d="M6 6l12 12M6 18L18 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                 </button>
             </div>
             <nav class="flex flex-col gap-2" aria-label="Menú móvil">
                <a href="#about" class="nav-link block px-3 py-3 rounded-md">Acerca de mí</a>
                <a href="#services" class="nav-link block px-3 py-3 rounded-md">Servicios</a>
                <a href="#projects" class="nav-link block px-3 py-3 rounded-md">Proyectos</a>
                <a href="#results" class="nav-link block px-3 py-3 rounded-md">Resultados</a>
                <a href="#process" class="nav-link block px-3 py-3 rounded-md">Proceso</a>
                <a href="#contact" class="nav-link block px-3 py-3 rounded-md">Contacto</a>
             </nav>
             
             <div class="pt-2 border-t border-[rgba(255,255,255,0.04)] mt-2 flex flex-col gap-3">
                <!-- CTA fullWidth -->
                 <Button client:load href="#contact" className="w-full justify-center" variant="outline">
                    Hablemos    
                </Button> 
                 <!-- Theme toggle -->
                  <div class="flex items-center justify-start">
                    <ThemeToggle client:load className="theme-toggle" />
                  </div>
             </div>
        </div>

        <!-- backdrop (click para cerrar) -->
         <div id="mobile-backdrop" class="mobile-backdrop md:hidden" aria-hidden="true"></div>
    </div>

    <!-- script del cliente: controla el scrolled y el menu movil -->

    <script type="module">
        (function(){
            const nav = document.getElementById("site-navbar");
            if(!nav) return;

            const toggleBtn = document.getElementById("nav-toggle")
            const closeBtn = document.getElementById("nav-close")
            const mobileMenu = document.getElementById("mobile-menu")
            const mobileBackdrop = document.getElementById("mobile-backdrop")
            const threshold = 16;

            const onScroll = ()=>{
                const y = window.scrollY || window.pageYOffset;
                if (y > threshold) nav.classList.add("scrolled");
                else nav.classList.remove("scrolled")
            }

            const openMenu = () => {
                nav.classList.add("menu-open")
                toggleBtn?.setAttribute("aria-expanded", "true");
                mobileMenu?.setAttribute("aria-hidden", "false");
                document.documentElement.style.overflow = "hidden";
            };

            const closeMenu = () => {
                nav.classList.remove("menu-open");
                toggleBtn?.setAttribute("aria-expanded", "false");
                mobileMenu?.setAttribute("aria-hidden", "true");
                document.documentElement.style.overflow = "";
            }  
            
            const toggleMenu = () => (nav.classList.contains("menu-open") ? closeMenu() : openMenu())

            /* inicio scrolled state */
            
            onScroll();
            window.addEventListener("scroll", onScroll, {passive: true})

            /* toggle events */

            toggleBtn?.addEventListener("click", toggleMenu);
            closeBtn?.addEventListener("click", closeMenu);
            mobileBackdrop?.addEventListener("click", closeMenu)

            /* close menu luego de click on link */

            mobileMenu?.querySelectorAll("a[href^='#']").forEach((a)=>{
                a.addEventListener("click", closeMenu)
            })

            /* close on escape */

            window.addEventListener("keydown", (e)=>{
                if(e.key === "Escape")closeMenu()
            })

            /* close menu if resizing to desktop */

            window.addEventListener("resize", ()=>{
                if (window.innerWidth >= 768)closeMenu()
            })
        })();
    </script>
</nav>
