---
import Modal from "../Modal.astro";
import Button from "../Button";
---

<Modal id="modal-web" variant="case-study" ariaLabel="Servicio: Plataformas Web">
  <div class="modal-layout-case-study">
    <!-- izquierda -->
    <div class="modal-case-left">
      <!-- header -->
      <div class="modal-case-header">
        <div class="modal-case-badges">
          <span class="modal-case-badge modal-case-badge-web">Servicio</span>
          <span class="modal-case-badge modal-case-badge-study">Web</span>
        </div>

        <h2 class="modal-case-title">Plataformas Web de Alto Rendimiento</h2>

        <p class="modal-case-intro">
          Tu web tiene que hacer mas que existir: tiene que generar confianza, carga rápida y
          movimiento real.
        </p>
      </div>

      <!-- body -->
      <div class="modal-case-body">
        <!-- ideal para -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Ideal para</h3>
          <ul class="modal-case-bullets">
            <li class="modal-case-bullet">
              Negocios que necesitan una web profesional para empezar a vender mejor online.
            </li>
            <li class="modal-case-bullet">
              Empresas con un sitio desactualizado, lento o que ya no representa su nivel actual.
            </li>
            <li class="modal-case-bullet">
              Proyectos que quieren crecer con una base sólida, sin rehacer todo más adelante.
            </li>
            <li class="modal-case-bullet">
              Marcas que necesitan transmitir confianza desde el primer segundo.
            </li>
          </ul>
        </div>

        <!-- Problema -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">El problema</h3>
          <p class="modal-case-section-text">
            Muchas webs se ven bien pero no convierten, cargan lento o no reflejan el nivel real del
            negocio. Eso genera pérdida de confianza y oportunidades.
          </p>
        </div>

        <!-- solucion -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Enfoque y solución</h3>
          <ul class="modal-case-bullets">
            <li class="modal-case-bullet">Diseño centrado en claridad y conversión.</li>
            <li class="modal-case-bullet">Desarrollo optimizado para velocidad.</li>
            <li class="modal-case-bullet">Arquitectura preparada para escalar.</li>
            <li class="modal-case-bullet">Responsive real en todos los dispositivos.</li>
            <li class="modal-case-bullet">Base SEO técnica desde el inicio.</li>
          </ul>
        </div>

        <!-- resultado -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Resultado</h3>
          <ul class="modal-case-bullets">
            <li class="modal-case-bullet">Web rápida y profesional.</li>
            <li class="modal-case-bullet">Mayor confianza en el usuario.</li>
            <li class="modal-case-bullet">Base sólida para crecimiento.</li>
          </ul>
        </div>

        <!-- FAQ -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Preguntas frecuentes</h3>
          <div class="modal-faq">
            <detail>
              <summary>¿Necesito tener todo definido?</summary>
              <p>No. Te ayudo a ordenar la idea y convertirla en una solución concreta.</p>
            </detail>
            <detail>
              <summary>¿Se puede escalar después?</summary>
              <p>Sí. Está pensando para crecer sin tener que rehacer todo.</p>
            </detail>
          </div>
        </div>
      </div>
    </div>

    <!-- derecha -->
    <div class="modal-case-right">
      <div class="modal-service-card">
        <h4>Enfoque</h4>
        <p>Performance, claridad y escalabilidad.</p>
      </div>
      <div class="modal-service-card">
        <h4>Tecnologías</h4>
        <p>Astro · React · Tailwind</p>
      </div>
      <div class="modal-service-card">
        <h4>Tiempo estimado</h4>
        <p>2 a 4 semanas</p>
      </div>
      <div class="modal-service-card">
        <h4>Resultado</h4>
        <p>Una web lista para crecer y convertir.</p>
      </div>
    </div>

    <!-- footer -->
    <div class="modal-case-footer">
      <Button
        href="#contact"
        variant="primary"
        size="sm"
        data-modal-close
        data-scroll-target="contact"
      >
        INICIAR PROYECTO
      </Button>
      <Button
        href="#services"
        variant="outline"
        size="sm"
        data-modal-close
        data-scroll-target="services"
      >
        VER OTROS SERVICIOS
      </Button>
    </div>
  </div>
</Modal>
