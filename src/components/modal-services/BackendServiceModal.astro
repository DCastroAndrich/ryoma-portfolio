---
import Button from "../Button";
import Modal from "../Modal.astro";
---

<Modal id="modal-backend" variant="case-study" ariaLabel="Servicio: Backend diseñado para escalar">
    <div class="modal-layout-case-study">
        <!-- izquierda -->
         <div class="modal-case-left">
            <!-- header -->
             <div class="modal-case-header">
                <div class="modal-case-badges">
                    <span class="modal-case-badge modal-case-badge-web">Servicio</span>
                    <span class="modal-case-badge modal-case-badge-study">Web</span>
                </div>

                <h2 class="modal-case-title">
                    Backend diseñado para escalar
                </h2>

                <p class="modal-case-intro">
                    Construyo backends sólidos, mantenibles y preparados para crecimiento. Arquitectura clara hoy, estabilidad asegurada mañana.
                </p>
             </div>

             <!-- body -->
              <div class="modal-case-body">
                <!-- ideal para -->
                 <div class="modal-case-section">
                    <h3 class="modal-case-section-title">Ideal para</h3>
                    <ul class="modal-case-bullets">
                        <li class="modal-case-bullet">Proyectos que van a crecer.</li>
                        <li class="modal-case-bullet">Startups en etapa de consolidación.</li>
                        <li class="modal-case-bullet">Equipos que necesitan orden técnico.</li>
                    </ul>
                 </div>

                 <!-- Problema -->
                  <div class="modal-case-section">
                    <h3 class="modal-case-section-title">El problema</h3>
                    <p class="modal-case-section-text">
                        Backends improvisados generan errores, bloqueos y dificultad para escalar. Cada cambio se vuelve riesgoso.
                    </p>
                  </div>

                  <!-- solucion -->
                   <div class="modal-case-section">
                    <h3 class="modal-case-section-title">Enfoque y solución</h3>
                    <ul class="modal-case-bullets">
                        <li class="modal-case-bullet">Estructura modular.</li>
                        <li class="modal-case-bullet">Código desacoplado.</li>
                        <li class="modal-case-bullet">Tipado fuerte.</li>
                        <li class="modal-case-bullet">Manejo de errores.</li>
                        <li class="modal-case-bullet">Base preparada para testing.</li>
                    </ul>
                   </div>

                   <!-- resultado -->
                    <div class="modal-case-section">
                        <h3 class="modal-case-section-title">Resultado</h3>
                        <ul class="modal-case-bullets">
                            <li class="modal-case-bullet">Mayor estabilidad.</li>
                            <li class="modal-case-bullet">Código mantenible.</li>
                            <li class="modal-case-bullet">Escalabilidad sin reescrituras.</li>
                            <li class="modal-case-bullet">Menos errores en producción.</li>
                        </ul>
                    </div>

                    <!-- FAQ -->
                     <div class="modal-case-section">
                        <h3 class="modal-case-section-title">Preguntas frecuentes</h3>
                        <div class="modal-faq">
                            <detail>
                                <summary>¿Sirve para proyectos chicos?</summary>
                                <p>Sí, si tienen intención de crecer.</p>
                            </detail>
                            <detail>
                                <summary>¿Incluye base de datos?</summary>
                                <p>Sí, diseño e integración completa.</p>
                            </detail>
                            <detail>
                                <summary>¿Se puede integrar con frontend existente?</summary>
                                <p>Sí, sin problema.</p>
                            </detail>
                        </div>
                     </div>

              </div>
         </div>
         
         <!-- derecha -->
          <div class="modal-case-right">

            <div class="modal-service-card">
                <h4>Enfoque</h4>
                <p>Arquitectura primero.</p>
                <p>Desarrollo después.</p>
                <p>Cada decisión técnica tiene impacto a largo plazo.</p>
            </div>
            <div class="modal-service-card">
                <h4>Tecnologías</h4>
                <p>NestJS · TypeScript · PostgreSQL · REST APIs</p>
            </div>
            <div class="modal-service-card">
                <h4>Tiempo estimado</h4>
                <p>2 a 5 semanas</p>
            </div>
            <div class="modal-service-card">
                <h4>Resultado</h4>
                <p>Un backend confiable, preparado para escalar sin fricción.</p>
            </div>
          </div>
          
          <!-- footer -->
           <div class="modal-case-footer">
            <Button href="#contact" variant="primary" size="sm" data-modal-close data-scroll-target="contact">
                INICIAR PROYECTO
            </Button>
            <Button href="#services" variant="outline" size="sm"  data-modal-close data-scroll-target="services">
                VER OTROS SERVICIOS
            </Button>

           </div>


    </div>

</Modal>