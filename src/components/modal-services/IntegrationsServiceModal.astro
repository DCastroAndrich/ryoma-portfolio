---
import Button from "../Button";
import Modal from "../Modal.astro";
---

<Modal id="modal-integrations" variant="case-study" ariaLabel="Servicio: Integraciones">
  <div class="modal-layout-case-study">
    <!-- izquierda -->
    <div class="modal-case-left">
      <!-- header -->
      <div class="modal-case-header">
        <div class="modal-case-badges">
          <span class="modal-case-badge modal-case-badge-web">Servicio</span>
          <span class="modal-case-badge modal-case-badge-study">Web</span>
        </div>

        <h2 class="modal-case-title">Integraciones que funcionan de verdad</h2>

        <p class="modal-case-intro">
          Conecto sistemas para que trabajen automáticamente y sin errores. Menos tareas manuales,
          más eficiencia operativa.
        </p>
      </div>

      <!-- body -->
      <div class="modal-case-body">
        <!-- ideal para -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Ideal para</h3>
          <ul class="modal-case-bullets">
            <li class="modal-case-bullet">Negocios que usan múltiples herramientas.</li>
            <li class="modal-case-bullet">Equipos que repiten tareas manuales.</li>
            <li class="modal-case-bullet">Procesos con datos duplicados.</li>
          </ul>
        </div>

        <!-- Problema -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">El problema</h3>
          <p class="modal-case-section-text">
            La falta de integración genera errores, pérdida de tiempo y datos inconsistentes.
          </p>
        </div>

        <!-- solucion -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Enfoque y solución</h3>
          <ul class="modal-case-bullets">
            <li class="modal-case-bullet">Integración entre APIs.</li>
            <li class="modal-case-bullet">Automatización de procesos.</li>
            <li class="modal-case-bullet">Sincronización de datos.</li>
            <li class="modal-case-bullet">Validación de consistencia.</li>
            <li class="modal-case-bullet">Manejo de errores.</li>
          </ul>
        </div>

        <!-- resultado -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Resultado</h3>
          <ul class="modal-case-bullets">
            <li class="modal-case-bullet">Eliminación de tareas manuales.</li>
            <li class="modal-case-bullet">Procesos más rápidos.</li>
            <li class="modal-case-bullet">Datos confiables.</li>
            <li class="modal-case-bullet">Menos errores humanos.</li>
          </ul>
        </div>

        <!-- FAQ -->
        <div class="modal-case-section">
          <h3 class="modal-case-section-title">Preguntas frecuentes</h3>
          <div class="modal-faq">
            <detail>
              <summary>¿Se puede integrar cualquier sistema?</summary>
              <p>Depende de si tiene API o acceso a datos.</p>
            </detail>
            <detail>
              <summary>¿Reemplaza herramientas?</summary>
              <p>No, las conecta.</p>
            </detail>
            <detail>
              <summary>¿Qué pasa si falla una integración?</summary>
              <p>Se contemplan controles y manejo de errores.</p>
            </detail>
          </div>
        </div>
      </div>
    </div>

    <!-- derecha -->
    <div class="modal-case-right">
      <div class="modal-service-card">
        <h4>Enfoque</h4>
        <p>No conecto herramientas, diseño cómo fluye la información.</p>
      </div>
      <div class="modal-service-card">
        <h4>Tecnologías</h4>
        <p>APIs · Webhooks · Node.js · Integraciones REST</p>
      </div>
      <div class="modal-service-card">
        <h4>Tiempo estimado</h4>
        <p>1 a 3 semanas</p>
      </div>
      <div class="modal-service-card">
        <h4>Resultado</h4>
        <p>Procesos automatizados que funcionan sin intervención manual.</p>
      </div>
    </div>

    <!-- footer -->
    <div class="modal-case-footer flex flex-col gap-3 sm:flex-row">
      <Button
        fullWidth
        href="#contact"
        variant="primary"
        size="sm"
        data-modal-close
        data-scroll-target="contact"
      >
        INICIAR PROYECTO
      </Button>
      <Button
        fullWidth
        href="#services"
        variant="outline"
        size="sm"
        data-modal-close
        data-scroll-target="services"
      >
        VER OTROS SERVICIOS
      </Button>
    </div>
  </div>
</Modal>
