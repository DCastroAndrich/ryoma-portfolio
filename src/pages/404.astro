---
import Layout from "../layout/Layout.astro";
import Button from "../components/Button";

import logoIcon from "../assets/logo-o.svg?raw";
---

<Layout
  title="404 - Página no encontrada | Ryōma Development"
  description="La página que estás buscando no existe o fue movida."
  noindex={true}
>
  <main
    class="mx-auto flex min-h-screen w-full max-w-7xl items-center justify-center px-4 py-16 sm:px-6 lg:px-8"
  >
    <section class="flex max-w-3xl flex-col items-center text-center">
      <a href="/" aria-label="Volver al inicio" class="mb-8">
        <span
          class="block h-12 w-auto sm:h-16"
          style="aspect-ratio: 278 / 200;"
          set:html={logoIcon}
          aria-hidden="true"
        />
      </a>

      <p class="font-heading text-text-primary mb-4 text-sm font-medium tracking-[0.2em] uppercase">
        Error 404
      </p>

      <h1
        id="not-found-title"
        class="font-heading text-4xl leading-tight font-semibold tracking-tight sm:text-5xl md:text-6xl"
      >
        Esta página no existe o fue movida.
      </h1>

      <p class="font-body text-text-primary mt-6 max-w-xl text-base leading-relaxed sm:text-lg">
        La página que estás buscando no se encuentra disponible. Puede que haya sido eliminada,
        movida o que nunca haya existido.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href="/" variant="primary" size="md"> Volver al inicio </Button>
      </div>
    </section>
  </main>
</Layout>
