---
import Layout from "../layout/Layout.astro";
import ContactForm from "../components/ContactForm";
import Button from "../components/Button";
import { Mail } from "lucide-react";
---

<Layout>
    <section id="contact" class="flex flex-col items-start justify-center h-auto px-10 pt-16 max-w-7xl gap-24 pb-18 ">
         <!-- titulo -->
        <div class="w-full h-auto gap-7.5 flex flex-col items-center justify-center text-heading  ">
            <h2 class="text-4xl font-bold font-heading tracking-heading-lg leading-heading-lg">
                Contacto
            </h2>
            <p class="text-lg font-light font-body tracking-subtitle leading-subtitle">¿Tenés un proyecto en mente? Contame en pocas palabras y te respondo dentro de 48 horas hábiles.</p>
        </div>
        
        <!-- FORMULARIO Y SIDEBAR -->
         <div class="contact-grid w-full">
        
            <!-- Columna izquierda -->
             <ContactForm client:load/>

             <!-- Columna derecha -->
              <aside class="contact-sidebar" >
                <!-- CTA rapido -->
                <div class="contact-sidebar-block">
                    <span class="contact-sidebar-label">¿Querés hablar ahora?</span>
                    <div class="contact-quick-cta">
                        <Button href="https://cal.com" variant="ghost" size="sm" client:load>
                            Reservar 15'
                        </Button>
                    </div>
                </div>
                <!-- Email y Disponibilidad -->
                 <div class="contact-sidebar-block">
                    <span class="contact-sidebar-label">Email directo</span>
                    <a href="mailto:hola@ryoma.dev" class="contact-email-link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                        hola@ryoma.dev
                    </a>

                    <span class="contact-sidebar-label" style="margin-top: : 0.5rem;">Disponibilidad</span>
                    <div class="contact-availability">
                        <p class="contact-availability-item">
                            <strong>Dispinibilidad:</strong> remoto · 10-20 h/sem
                        </p>
                        <p class="contact-availability-item">
                            <strong>Idiomas:</strong> Español / Inglés
                        </p>
                    </div>
                 </div>

                 <!-- FAQ -->
                  <div class="contact-sidebar-block">
                    <span class="contact-sidebar-label">FAQ</span>
                    <div class="contact-faq">
                        <div class="contact-faq-item">
                            <span class="contact-faq-q">¿Cuánto demora un landing?</span>
                            <span class="contact-faq-arrow">→</span>
                            <span class="contact-faq-a">2 - 3 semanas.</span>
                        </div>
                        <div class="contact-faq-item">
                            <span class="contact-faq-q">¿Hacés mantenimiento?</span>
                            <span class="contact-faq-arrow">→</span>
                            <span class="contact-faq-a">Sí, planes mensuales.</span>
                        </div>
                        <div class="contact-faq-item">
                            <span class="contact-faq-q">¿Trabajás con equipos?</span>
                            <span class="contact-faq-arrow">→</span>
                            <span class="contact-faq-a">Sí, con metodologías ágiles.</span>
                        </div>
                    </div>
                  </div>

              </aside>
         </div>
         
    </section>

</Layout>