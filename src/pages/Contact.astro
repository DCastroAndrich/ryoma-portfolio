---
import Layout from "../layout/Layout.astro";
import ContactForm from "../components/ContactForm";
import Button from "../components/Button";
import { Mail, CalendarDays, ArrowUpRight, Sparkles, Clock3, Languages, MessageSquareQuote } from "lucide-react";
---
<Layout>
    <section id="contact" class="py-16 md:py-24">
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-12 md:gap-16">
        
            <header class="text-center max-w-2xl mx-auto flex flex-col gap-4">
                <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-heading-lg leading-heading-lg">
                    Contacto
                </h2>
                <p class="font-body text-base md:text-lg font-light tracking-subtitle leading-subtitle text-text-primary/85">
                    ¿Tenés un proyecto en mente? Contame en pocas palabras y te respondo dentro de 48 horas hábiles.
                </p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.85fr)] gap-6 md:gap-8 items-start">
                <ContactForm client:load/>
                
                <aside class="flex flex-col gap-6">
                    <div class="rounded-[28px] border border-white/10 bg-white/3 p-6 md:p-8 flex flex-col gap-4">
                        <div class="flex items-center gap-3">
                            <span class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/4 p-3">
                                <CalendarDays size={18} strokeWidth={1.6} />    
                            </span>

                            <div class="flex flex-col gap-1">
                                <span class="font-heading text-sm uppercase tracking-[0.08em] text-text-primary/70 ">
                                    ¿Querés hablar ahora?
                                </span>
                                <span class="font-body text-sm text-text-primary/70">
                                    Coordinemos una llamada corta
                                </span>
                            </div>    
                        </div>

                        <Button href="https://cal.com" target="_blank" variant="ghost" size="sm" >
                            Reservar 15' <ArrowUpRight size={16}/>
                        </Button>
                    </div>

                    <div class="rounded-[28px] border border-white/10 bg-white/3 p-6 md:p-8 flex flex-col gap-4">
                        <div class="flex flex-col gap-3">
                            <span class="inline-flex items-center gap-2 font-heading text-sm uppercase tracking-[0.08em] text-text-primary/70">
                                
                                Email directo
                            </span>

                            <a href="mailto:hola@ryoma.dev" class="inline-flex items-center gap-2 font-body text-sm md:text-base text-text-primary/90 hover:text-text-primary transition-colors">
                                <Mail size={16} strokeWidth={1.6} />
                                hola@ryoma.dev
                            </a>
                        </div>

                        <div class="flex flex-col gap-5">
                            <span class="inline-flex items-center gap-2 font-heading text-sm uppercase tracking-[0.08em] text-text-primary/70">
                                
                                Disponibilidad
                            </span>

                            <div class="flex flex-col gap-2 font-body text-sm md:text-base text-text-primary/85 ">
                                <p class="inline-flex items-center gap-2">
                                    <Clock3 size={14} strokeWidth={1.8} />
                                    remoto · 10-20 h/sem
                                </p>
                                <p class="inline-flex items-center gap-2">
                                    <Languages size={14} strokeWidth={1.8}/>
                                    Español / Inglés
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="rounded-[28px] border border-white/10 bg-white/3 p-6 md:p-8 flex flex-col gap-4">
                        <span class="inline-flex items-center gap-2 font-heading text-sm uppercase tracking-[0.08em] text-text-primary/70">
                            <MessageSquareQuote size={16} strokeWidth={1.6} />
                            FAQ
                        </span>

                        <div class="flex flex-col divide-y divide-white/10">
                            <div class="py-3 flex items-start justify-between gap-4">
                                <span class="font-body text-sm text-text-primary/85"> ¿Cuánto demora un landing?</span>
                                <span class="font-body text-sm text-text-primary/65">2 - 3 semanas.</span>
                            </div>
                            <div class="py-3 flex items-start justify-between gap-4">
                                <span class="font-body text-sm text-text-primary/85">¿Hacés mantenimiento?</span>
                                <span class="font-body text-sm text-text-primary/65">Sí, planes mensuales.</span>
                            </div>
                            <div class="py-3 flex items-start justify-between gap-4">
                                <span class="font-body text-sm text-text-primary/85">¿Trabajás con equipos?</span>
                                <span class="font-body text-sm text-text-primary/65">Sí, con metodologías ágiles.</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</Layout>
