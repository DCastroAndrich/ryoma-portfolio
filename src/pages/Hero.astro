---
import Layout from "../layout/Layout.astro"
import LogoLight from "../assets/logo-light.svg"
import RyomaLogoLight from "../assets/logotipo-ryōma-light.svg"
import DevelLogoLight from "../assets/logotipo-development-light.svg"
import Button from "../components/Button"
import TechStack from "../components/TechStack"


/* iconos */
import astroIconRaw from "../assets/tech-icons/astro.svg"
import nextJSIconRaw from "../assets/tech-icons/nextjs.svg"
import nestJSIconRaw from "../assets/tech-icons/nestjs.svg"
import tsIconRaw from "../assets/tech-icons/typescript.svg"
import postgreSQLIconRaw from "../assets/tech-icons/postgresql.svg"
import prismaIconRaw from "../assets/tech-icons/prisma.svg"
import reactIconRaw from "../assets/tech-icons/react.svg"
import nodeJSIconRaw from "../assets/tech-icons/nodejs.svg"
import mongoIconRaw from "../assets/tech-icons/mongodb.svg"


const techStack = [
    {name: "ASTRO", icon: astroIconRaw},
    {name: "NEXT JS", icon: nextJSIconRaw},
    {name: "NEST JS", icon: nestJSIconRaw},
    {name: "TYPESCRIPT", icon: tsIconRaw},
    {name: "POSTGRESQL", icon: postgreSQLIconRaw},
    {name: "PRISMA ORM", icon: prismaIconRaw},
    {name: "REACT", icon: reactIconRaw},
    {name: "NODE JS", icon: nodeJSIconRaw},
    {name: "MONGO DB", icon: mongoIconRaw}
]

---
<Layout>
    <section class="max-w-7xl h-auto flex flex-col items-center justify-center gap-15 py-13">
        <!-- glow -->
         <!-- glow-left -->
        <div class="glow glow-left">
        </div>
            <!-- glow-right -->
        <div class="glow glow-right">
        </div>

        <!-- logos -->
         <div class="flex flex-col items-center justify-center gap-10">
            <!-- Ō logo -->
            <span class="relative inline-block w-75 h-62.5">
                <LogoLight width={300} height={250}  aria-hidden/>
            </span>

            <div class="flex flex-col items-center justify-center gap-9">
                <div class="flex flex-col items-center justify-center gap-5">
                    <!-- Text logos -->
                    <RyomaLogoLight width={469.23} height={84}  aria-hidden/>
                    <DevelLogoLight width={372.59} height={36}  aria-hidden/>
                </div>
                <p class="font-heading font-semibold text-xl text-center hero-text w-3xl">Soluciones digitales con precisión metódica. Entregando valor de alto rendimiento.</p>
            </div>
         </div>
         <!-- CTA & Icons -->
         <div class="flex flex-col items-center justify-start w-auto h-auto gap-15">
            <!-- CTA -->
            <div class="flex items-center justify-center gap-13 w-auto h-auto">
                <Button href="#contact" variant="primary" weight={500} client:load>
                    HABLEMOS
                </Button>
                <Button href="#contact" variant="outline" weight={500}  client:load>
                    PROYECTOS
                </Button>
            </div>
            <TechStack items={techStack} client:load/>

         </div>
    </section>

</Layout>