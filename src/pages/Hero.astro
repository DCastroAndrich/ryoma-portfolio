---
import Layout from "../layout/Layout.astro"
import LogoLight from "../assets/Logo Light.svg"
import RyomaLogo from "../assets/Ryōma Logotipo Light.svg"
import DevelLogo from "../assets/Development Logotipo Light.svg"
---
<Layout>
    <section class="max-w-7xl h-auto flex flex-col items-center justify-center gap-15 py-13">
        <!-- glow -->
         <!-- glow-left -->
        <div class="glow glow-left">

        </div>
            <!-- glow-right -->
        <div class="glow glow-right">

        </div>

        <!-- logos -->
         <div class="flex flex-col items-center justify-center gap-10">
            <LogoLight width={300} height={250}/>

            <div class="flex flex-col items-center justify-center gap-9">
                <div class="flex flex-col items-center justify-center gap-5">
                    <RyomaLogo width={469.23} height={84}/>
                    <DevelLogo width={372.59} height={36}/>
    
                </div>
                <p class="font-heading font-semibold text-xl text-center text-white w-3xl">Soluciones digitales con precisión metódica. Entregando valor de alto rendimiento.</p>
            </div>

         </div>
            
    </section>

</Layout>